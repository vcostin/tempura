{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A --node-modules-dir npm:vite",
    "build": "deno run -A ./node_modules/typescript/bin/tsc --noEmit && deno run -A --node-modules-dir npm:vite build",
    "preview": "deno run -A --node-modules-dir npm:vite preview",
    "tauri": "NO_STRIP=true APPIMAGE_EXTRACT_AND_RUN=1 deno run -A ./scripts/tauri-ci.ts",
    "tauri:dev": "deno run -A --node-modules-dir npm:@tauri-apps/cli dev",
    "tauri:build": "NO_STRIP=true APPIMAGE_EXTRACT_AND_RUN=1 deno run -A ./scripts/tauri-ci.ts build",
    "version": "deno run -A ./scripts/bump-version.ts",
    "test:unit": "deno run -A --sloppy-imports tests/unit/sessionAnnounce.test.ts",
    "playwright:install": "deno run -A npm:@playwright/test@1.60.0/cli install chromium",
    "test:a11y": "PW_DISABLE_TS_ESM=1 deno run -A npm:@playwright/test@1.60.0/cli test",
    "test": "deno task test:unit && deno task test:a11y"
  },
  "compilerOptions": {
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "jsx": "react-jsx",
    "strict": true
  }
}
